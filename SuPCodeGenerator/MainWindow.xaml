<Window x:Class="SuPCodeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-Audio超级用户授权码生成器" Height="196" Width="512" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Topmost="True" Activated="Window_Activated" Closed="Window_Closed">
    <Grid>
        <DockPanel>
            <!--停靠布局，让菜单栏和工具栏位于窗口顶部-->
            <Grid DockPanel.Dock="Top" Height="136">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="80*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="16, 4, 8, 4" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"  Text="系统时间:" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="16, 4, 8, 4" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"  Text="请求码:" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="16, 4, 8, 4" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"  Text="授权码:"  />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4, 4, 16, 4" FontFamily="Consolas" FontSize="20" VerticalAlignment="Stretch" TextAlignment="Left" VerticalContentAlignment="Center" Foreground="Black" IsReadOnly="True" Name="txtTime" BorderThickness="0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4, 4, 16, 4" FontFamily="Consolas" FontSize="20" VerticalAlignment="Stretch"  TextAlignment="Left" VerticalContentAlignment="Center" Foreground="Black" IsReadOnly="False" Name="txtDeviceCode" MaxLength="32" TextChanged="txtDeviceCode_TextChanged"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4, 4, 16, 4" FontFamily="Consolas" FontSize="20" VerticalAlignment="Stretch" TextAlignment="Left" VerticalContentAlignment="Center" Foreground="Black" IsReadOnly="True" Name="txtPermissionCode" MaxLength="32"/>
                </Grid>
            </Grid>
            <StatusBar DockPanel.Dock="Bottom" Width="Auto">
                <Grid Width="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="16, 4, 8, 4" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"  Text="System" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="16, 4, 8, 4" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"  Text="Ctrl + Shift + Alt + F7" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="16, 4, 8, 4" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"  Text="Music: 76  Mic: 77  Effect: 7"  />
                </Grid>
            </StatusBar>
        </DockPanel>
    </Grid>
</Window>
